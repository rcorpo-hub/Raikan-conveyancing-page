# Copy this template to .env and fill credentials there. Requires Node.js 22+.
# Keep .env private. Never put server secrets in VITE_* variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_APP_URL=http://localhost:5173
# Production: use your HTTPS website origin and hosting-assigned HOST/PORT.
# Enable only behind a trusted proxy that sanitizes X-Forwarded-For.
TRUST_PROXY=false

# SUPABASE: project settings -> Data API / API Keys.
# URL example: https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
# Recommended server secret key, starting sb_secret_...
SUPABASE_SECRET_KEY=
# Alternatively use the legacy service_role key. Fill ONE server-key field only.
SUPABASE_SERVICE_ROLE_KEY=
# Apply the SQL files under supabase/migrations in order before using storage.

# SINCH ENGAGE: Settings -> API Settings -> Basic Authentication.
# Basic authorization is generated from the API key and secret by the server.
# Use the regional base URI only, without /v1/messages.
SINCH_BASE_URL=https://au.app.api.sinch.com
SINCH_API_KEY=
SINCH_API_SECRET=
# Leave blank if you have no sender ID: Sinch uses the account's default sender.
SINCH_SENDER_ID=
# Use INTERNATIONAL for a registered dedicated phone number.
SINCH_SENDER_TYPE=ALPHANUMERIC
# SMS, MMS or RCS. MMS/RCS need account enablement; RCS includes SMS fallback.
SINCH_CHANNEL=SMS
# Public HTTPS image URL: required for MMS, optional for an RCS card.
SINCH_MEDIA_URL=
SINCH_RCS_TITLE=Your Raikan conveyancing quote
SMS_ALLOWED_CALLING_CODES=61
SMS_MAX_SEGMENTS=10

# EMAIL: Gmail / Google Workspace SMTP for quote emails and PDF attachments.
# Email and SMS are BOTH part of the live service and run independently.
# Neither waits for the other. Leave both false until credentials are filled;
# then set SMS_ENABLED=true and EMAIL_ENABLED=true when ready for live sends.
SMS_ENABLED=false
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Google app password / SMTP credential, not your normal Gmail password.
SMTP_PASSWORD=
# Example: Raikan Conveyancing <quotes@your-company-domain.com>
EMAIL_FROM=
# Internal enquiry/callback report recipient, if wanted.
TEAM_EMAIL=

# ANTI-ABUSE: Cloudflare Turnstile keys for your website domain.
# Both required in production. Site key is public; secret stays on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate EACH secret independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep LEAD_TOKEN_SECRET stable after launch; rotation needs a planned migration.
LEAD_TOKEN_SECRET=
RATE_LIMIT_SALT=
REQUESTS_PER_HOUR=10
QUOTES_PER_PHONE_PER_DAY=3

# DELIVERY WORKER: database-backed queue; independent email and SMS processing.
# Previously disabled jobs are not automatically sent when credentials are added.
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000

# VAPI AI CALLS: disabled until you configure, migrate and test. Never expose the private API key.
# Keep test mode on first; only exact allowlisted numbers can receive calls.
VAPI_ENABLED=false
VAPI_TEST_MODE=true
VAPI_TEST_NUMBERS=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Generate a NEW random secret (not the API key); use it in Vapi's Bearer custom credential.
VAPI_WEBHOOK_SECRET=
# ID of that custom credential in Vapi -> Integrations -> Server Configuration.
VAPI_SERVER_CREDENTIAL_ID=
# Full public HTTPS webhook URL; use a development tunnel for localhost.
# Example: https://conveyancing.rcorpo.com/api/vapi/webhook
VAPI_SERVER_URL=
VAPI_CALL_DELAY_SECONDS=30
VAPI_MAX_CALL_SECONDS=300
VAPI_ALLOWED_CALLING_CODES=61
# Weekdays only, using this timezone, including daylight saving.
# Review recipient timezones before expanding beyond SA. Add public holidays as YYYY-MM-DD.
VAPI_TIMEZONE=Australia/Adelaide
VAPI_CALL_START_HOUR=9
VAPI_CALL_END_HOUR=17
VAPI_BLOCKED_DATES=
# Real authorised Bhavesh number in +61... format; blank disables the transfer tool in exported config.
VAPI_TRANSFER_NUMBER=
# Real business email read aloud when asked (no invented fallback).
VAPI_BUSINESS_EMAIL=
# Choose/test an Australian voice in Vapi Voice Library, then set these for the assistant export.
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
# Optional language-model selection for the assistant export; billed/configured through Vapi.
VAPI_MODEL=gpt-4.1-mini
